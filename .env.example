# --- Admin panel ---
# Password for /admin (defaults to "ptd-admin" when unset).
ADMIN_PASSWORD=change-me

# --- Partner programmes (four partners) ---
# Values here override the ids stored in src/content/partners.json and keep
# secrets out of git. Leave empty until the programme is approved — offers and
# CTA buttons stay hidden until then (that is the intended behaviour).
#   booking      -> Booking.com via Travelpayouts   (partner "booking")
#   aviasales    -> Aviasales via Travelpayouts     (partner "aviasales")
#   trip         -> Trip.com via Travelpayouts      (partner "trip")
#   travellead   -> TravelLead (manual catalogue)   (partner "travellead")
BOOKING_AID=
AVIASALES_MARKER=
TRIP_AID=
TRAVELLEAD_ID=

# --- Optional: real e-mail delivery for contact/newsletter forms ---
# Without RESEND_API_KEY, submissions are appended to content/outbox (local dev)
# or written to the serverless function log on Vercel.
RESEND_API_KEY=
EMAIL_TO=kontakt@polskatraveldeals.vercel.app
EMAIL_FROM=Polska Travel Deals <onboarding@resend.dev>
